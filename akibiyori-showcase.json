{
  "version": 1,
  "theme_scope": "akibiyori-showcase",
  "theme": {
    "catalog": [
      {"builtin": "fumadocs"},
      {"builtin": "neutral-example"},
      {"file": "examples/observatory/themes/neutral-profile/theme.json"},
      {"builtin": "house"},
      {"builtin": "forest"}
    ],
    "deploy": {"dark": "ember-ink-dark", "light": "maple-mist-light"},
    "presentation": "demo",
    "demo_default": "maple-mist-light",
    "mode": "system"
  },
  "docs": {"site": "docs", "route": "/docs/", "label": "Akibiyori Docs"},
  "categories": [
    {"id": "openapi", "label": "OpenAPI demos", "site": "docs", "route": "/demos/openapi/"}
  ],
  "sites": [
    {"id": "docs", "label": "Akibiyori Docs", "config": "akibiyori-docs.json", "mount": "", "entry_route": "/docs/"},
    {"id": "observatory", "label": "Observatory tutorial API", "config": "examples/observatory/config.json", "mount": "/demos/observatory", "entry_route": "/", "category": "openapi"},
    {"id": "planets", "label": "Scalar Galaxy API", "config": "examples/planets.json", "mount": "/demos/planets", "entry_route": "/reference/", "category": "openapi"},
    {"id": "kubernetes", "label": "Kubernetes API Extensions", "config": "examples/kubernetes/config.json", "mount": "/demos/kubernetes", "entry_route": "/", "category": "openapi"},
    {"id": "petstore", "label": "Swagger Petstore API", "config": "examples/petstore/config.json", "mount": "/demos/petstore", "entry_route": "/reference/", "category": "openapi"}
  ]
}
