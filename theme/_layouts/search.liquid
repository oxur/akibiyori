<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "icons.liquid" %}
  <meta name="description" content="Search {{ site.title | escape }} documentation">
  <title>{{ page.title | escape }} · {{ site.title | escape }}</title>
  <link rel="preload" href="__AKIBIYORI_BASE_PATH__/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="__AKIBIYORI_BASE_PATH__/css/akibiyori-fonts.css">
  <link rel="stylesheet" href="__AKIBIYORI_BASE_PATH__/css/fumadocs-reference.css">
  <link rel="stylesheet" href="__AKIBIYORI_BASE_PATH__/css/akibiyori-tokens.css">
  <link rel="stylesheet" href="__AKIBIYORI_BASE_PATH__/css/akibiyori.css">
  <link rel="stylesheet" href="__AKIBIYORI_BASE_PATH__/pagefind/pagefind-ui.css">
</head>
<body class="framework relative flex min-h-screen flex-col">
  <a class="skip-link" href="#main">Skip to content</a>
  <header id="nd-subnav" class="reference-topbar [grid-area:header]" data-pagefind-ignore>
    <button class="sidebar-toggle" type="button" aria-controls="nd-sidebar" aria-expanded="false">Menu</button>
    <a class="reference-brand inline-flex items-center gap-2 font-semibold" href="{{ site.data.akibiyori_site.home_href | escape }}">{% if site.data.akibiyori_site.icon_href %}<img class="brand-icon" src="{{ site.data.akibiyori_site.icon_href | escape }}" width="20" height="20" alt="" aria-hidden="true">{% endif %}<span>{{ site.title | escape }}</span></a>
    <a class="topbar-search" href="{{ site.data.akibiyori_site.search_href | escape }}" aria-current="page"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>Search</a>
  </header>
  <div id="fd-spacious-layout" class="reference-frame relative grid min-h-(--fd-layout-height) bg-fd-card [--fd-layout-height:calc(100dvh-var(--fd-banner-height,0px))] [--fd-header-height:--spacing(14)] [--fd-page-width:760px] [--fd-sidebar-width:0px] [--fd-sidebar-col:var(--fd-sidebar-width)] [--fd-toc-width:0px] md:h-(--fd-layout-height) md:overflow-clip print:h-auto print:overflow-visible" style="grid-template: &quot;sidebar header right&quot; auto &quot;sidebar toc-popover right&quot; var(--fd-toc-popover-height, 0px) &quot;sidebar main right&quot; 1fr / var(--fd-sidebar-col) minmax(0, 1fr) auto">
    {% include "navigation.liquid" %}
    <main id="main" class="reference-main search-main [grid-area:main]" data-pagefind-ignore>
      <div class="reference-panel search-panel @container relative flex min-w-0 min-h-0 flex-col [grid-area:main] mx-2 bg-fd-background md:ms-0 md:my-2 md:overflow-clip md:rounded-2xl md:border md:shadow-sm">
        <div class="panel-header" data-pagefind-ignore><button id="sidebar-reopen" class="sidebar-reopen" type="button" aria-label="Reopen navigation" aria-controls="nd-sidebar" aria-expanded="false" hidden><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-left"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg></button></div>
        <div class="reference-scroll-row search-scroll-row">
          <article class="reference-article flex flex-col gap-4 w-full min-w-0 max-w-(--fd-page-width) pt-6 pb-8">
            <div class="prose flex-1 text-fd-foreground/90">{{ page.content }}</div>
          </article>
        </div>
      </div>
    </main>
  </div>
  <script src="__AKIBIYORI_BASE_PATH__/pagefind/pagefind-ui.js" defer></script>
  <script src="__AKIBIYORI_BASE_PATH__/js/akibiyori-search.js" defer></script>
  <script src="__AKIBIYORI_BASE_PATH__/js/akibiyori-reading.js" defer></script>
</body>
</html>
